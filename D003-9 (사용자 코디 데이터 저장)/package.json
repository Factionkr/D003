{
  "name": "daily-fit-archive",
  "version": "1.0.0",
  "description": "AI Fashion Styling App - Daily Fit Archive & Virtual Try-On History Module",
  "main": "dist/app.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "dev:server": "ts-node-dev --respawn src/app.ts",
    "dev:client": "vite",
    "start": "node dist/app.js",
    "migration:run": "psql -f src/migrations/001_create_fit_archive_tables.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.1",
    "sharp": "^0.33.2",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "html2canvas": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
